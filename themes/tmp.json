{
    "name": "Sonora Dark",
    "type": "dark",
    "colors": {
      "editor.background": "#1E1E1E",
      "editor.foreground": "#D9E0EE",
      "editor.selectionBackground": "#3A3A3A",
      "editor.lineHighlightBackground": "#2A2A2A",
      "editorCursor.foreground": "#F5E0DC",
      "editorLineNumber.foreground": "#6E6A86",
      "editorLineNumber.activeForeground": "#D9E0EE",
      "editor.inactiveSelectionBackground": "#2a2a2a2e",
      "editor.selectionHighlightBackground": "#3a3a3a27",
      "editorWhitespace.foreground": "#3A3A3A",
      "editorIndentGuide.background1": "#303030",
      "editorIndentGuide.activeBackground1": "#505050",
      "sideBar.background": "#1B1B1B",
      "activityBar.background": "#1B1B1B",
      "activityBar.foreground": "#D9E0EE",
      "statusBar.background": "#1B1B1B",
      "statusBar.foreground": "#8B8B8B",
      "panel.background": "#1E1E1E",
      "terminal.background": "#1E1E1E",
      "terminal.foreground": "#D9E0EE",
      "terminal.ansiBlack": "#1E1E1E",
      "terminal.ansiRed": "#F28FAD",
      "terminal.ansiGreen": "#A6E3A1",
      "terminal.ansiYellow": "#FAE3B0",
      "terminal.ansiBlue": "#89DCEB",
      "terminal.ansiMagenta": "#CBA6F7",
      "terminal.ansiCyan": "#8BD5CA",
      "terminal.ansiWhite": "#D9E0EE",
      "terminal.ansiBrightBlack": "#3A3A3A",
      "terminal.ansiBrightWhite": "#FFFFFF"
    },
    "tokenColors": [
      {
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": { "foreground": "#6E6A86", "fontStyle": "italic" }
      },
      {
        "scope": ["keyword", "storage.type"],
        "settings": { "foreground": "#CBA6F7" }
      },
      {
        "scope": ["variable", "meta.definition.variable"],
        "settings": { "foreground": "#D9E0EE" }
      },
      {
        "scope": ["variable.language", "constant.language"],
        "settings": { "foreground": "#FAE3B0" }
      },
      {
        "scope": ["constant.numeric", "constant.character.numeric"],
        "settings": { "foreground": "#F5C2E7" }
      },
      {
        "scope": ["string", "constant.other.symbol"],
        "settings": { "foreground": "#F2CDCD" }
      },
      {
        "scope": ["entity.name.function", "support.function"],
        "settings": { "foreground": "#8BD5CA" }
      },
      {
        "scope": ["entity.name.type", "support.class", "storage.type.class"],
        "settings": { "foreground": "#89DCEB" }
      },
      {
        "scope": ["entity.name.tag"],
        "settings": { "foreground": "#CBA6F7" }
      },
      {
        "scope": ["meta.import", "variable.parameter"],
        "settings": { "foreground": "#DDB6F2" }
      },
      {
        "scope": ["invalid", "invalid.deprecated"],
        "settings": { "foreground": "#F28FAD", "fontStyle": "underline" }
      }
    ]
  }
